{
  "name": "crm-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && esbuild scripts/worker.ts --bundle --platform=node --external:pg --external:sharp --format=esm --outfile=dist/worker.mjs",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
