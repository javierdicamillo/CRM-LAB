{
  "name": "portal-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build && esbuild scripts/migrate.ts scripts/agency.ts scripts/maintenance.ts --bundle --platform=node --external:pg --external:@electric-sql/pglite --format=esm --outdir=dist",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "agency": "tsx scripts/agency.ts",
    "preview": "tsx scripts/preview.ts",
    "maintenance": "tsx scripts/maintenance.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
