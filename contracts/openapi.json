          },
          "429": {
            "description": "Cuota excedida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Segundos antes de reintentar."
              }
            }
          },
          "503": {
            "description": "Servicio temporalmente no disponible; reintentar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Cursor opaco. null en respuesta indica fin; volver a empezar para pendientes."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            }
          },
          {
            "name": "include_delivered",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Para recuperar una copia: incluye confirmadas todavía retenidas, durante 7 días."
          }
        ],
        "description": "Pendientes hasta 30 días con alertas previas. Recorra todas las páginas y reinicie sin cursor al terminar. La consulta recibida se guarda durablemente en CRM antes de confirmar."
      }
    },
