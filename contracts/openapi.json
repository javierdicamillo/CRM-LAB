    "/v1/reconcile": {
      "post": {
        "operationId": "reconcileActiveListings",
        "summary": "Verificar manifiesto completo y renovar vigencia",
        "tags": [
          "Listings"
        ],
        "responses": {
          "200": {
            "description": "matched=true renueva 72 horas; false no renueva y devuelve diferencias.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReconcileReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Credencial ausente, inválida o revocada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Conexión suspendida o permiso insuficiente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Datos inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Cuota excedida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Segundos antes de reintentar."
              }
            }
          },
          "503": {
            "description": "Servicio temporalmente no disponible; reintentar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReconcileRequest"
              }
            }
          }
        },
        "description": "Comparar todos los IDs y revisiones activos propios. Un manifiesto incompleto no elimina registros. Las bajas se confirman con PUT y revisión superior."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AgencyToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token opaco aleatorio y exclusivo de cada conexión. No es JWT obligatorio. El portal guarda su hash y resuelve la agencia, nunca confía en agency_id del cliente."
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "additionalProperties": false
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "portal_instance_id": {
            "type": "string",
            "format": "uuid"
          },
          "protocol_versions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "max_active_listings": {
            "type": "integer",
            "minimum": 1
          },
          "max_image_bytes": {
            "type": "integer"
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "portal_instance_id",
          "protocol_versions",
          "max_active_listings",
          "max_image_bytes",
          "server_time"
        ],
        "additionalProperties": false
      },
      "PublicListing": {
        "type": "object",
        "properties": {
          "source_property_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "description": {
            "type": "string",
            "maxLength": 10000,
            "description": "Texto plano público. Sin notas privadas."
          },
          "operation": {
            "type": "string",
            "enum": [
              "sale",
              "rent"
            ]
          },
          "property_type": {
            "type": "string",
            "enum": [
              "apartment",
              "house",
              "land",
              "office",
              "store",
              "warehouse",
              "other"
            ]
          },
          "price": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "period": {
                "type": "string",
                "enum": [
                  "total",
                  "month",
                  "day"
                ]
              }
            },
            "required": [
              "amount",
              "currency",
              "period"
            ],
            "additionalProperties": false
          },
          "location": {
            "type": "object",
            "properties": {
              "country_code": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "region": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "neighborhood": {
                "type": "string"
              },
              "public_address": {
                "type": "string",
                "description": "Solo dirección autorizada para publicación."
              }
            },
            "required": [
              "country_code",
              "region",
              "city"
            ],
            "additionalProperties": false
          },
          "area_m2": {
            "type": "number",
            "minimum": 0
          },
          "bedrooms": {
            "type": "integer",
            "minimum": 0
          },
          "bathrooms": {
            "type": "integer",
            "minimum": 0
          },
          "media_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "cadastre": {
            "type": "object",
            "description": "Solo con autorización expresa de publicar nomenclatura y ubicación exacta. Requiere protocolo 1.1. No identifica unidades funcionales ni acredita dominio.",
            "properties": {
              "province": {
                "const": "AR-Q",
                "type": "string"
              },
              "nomenclature": {
                "type": "string",
                "pattern": "^[0-9]{15}$"
              }
            },
            "required": [
              "province",
              "nomenclature"
            ],
            "additionalProperties": false
          }
        },
        "required": [
