{
  "openapi": "3.1.0",
  "info": {
    "title": "CRM-LAB y PORTAL-LAB — Protocolo LAB",
    "version": "1.1.0",
    "description": "Protocolo LAB implementado por PORTAL-LAB. v1.1 añade referencia catastral pública opcional; compatible con productores 1.0 sin ese campo."
  },
  "servers": [
    {
      "url": "https://portal-lab.example.invalid",
      "description": "Marcador documental; sustituir al desplegar."
    }
  ],
  "security": [
    {
      "AgencyToken": []
    }
  ],
  "tags": [
    {
      "name": "Compatibility",
      "description": "Negociación de protocolo."
    },
    {
      "name": "Listings",
      "description": "Publicaciones propias y reconciliación."
    },
    {
      "name": "Media",
      "description": "Derivados públicos autorizados."
    },
    {
      "name": "Inquiries",
      "description": "Entrega de consultas de la agencia autenticada."
    }
  ],
  "paths": {
    "/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "summary": "Consultar protocolo y límites",
        "tags": [
          "Compatibility"
        ],
        "responses": {
          "200": {
            "description": "Capacidades de la instancia del portal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "401": {
            "description": "Credencial ausente, inválida o revocada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Conexión suspendida o permiso insuficiente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Datos inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Cuota excedida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Segundos antes de reintentar."
              }
            }
          },
          "503": {
            "description": "Servicio temporalmente no disponible; reintentar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
