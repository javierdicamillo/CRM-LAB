                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListingUpdate"
              }
            }
          }
        },
        "description": "Identidad compuesta por agencia autenticada e ID de origen. Publicar requiere medios ready propios. Una baja mantiene su revisión. No devolver ni almacenar campos privados."
      }
    },
    "/v1/media": {
      "post": {
        "operationId": "uploadPublicMedia",
        "summary": "Subir una imagen pública y recodificarla",
        "tags": [
          "Media"
        ],
        "responses": {
          "200": {
            "description": "Reintento idempotente ya procesado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaReceipt"
                }
              }
            }
          },
          "201": {
            "description": "Medio validado y listo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Credencial ausente, inválida o revocada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Conexión suspendida o permiso insuficiente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Misma clave idempotente con contenido distinto.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Imagen excede cuota o dimensiones.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Datos inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Cuota excedida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Segundos antes de reintentar."
              }
            }
          },
          "503": {
            "description": "Servicio temporalmente no disponible; reintentar.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Clave persistente por subida dentro de la conexión."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/webp": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "description": "Máximo propuesto 10 MB y 25 megapíxeles. El portal valida, recodifica y elimina EXIF. No se aceptan URLs arbitrarias. La imagen solo se sirve públicamente si está referenciada por una ficha activa."
      }
    },
    "/v1/inquiries": {
      "get": {
        "operationId": "getOwnInquiries",
        "summary": "Recoger consultas de la agencia autenticada",
        "tags": [
          "Inquiries"
        ],
        "responses": {
          "200": {
            "description": "Entrega al menos una vez; el cursor no es ACK.",
