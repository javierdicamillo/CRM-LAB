# CRM_DOMAIN se define en el .env privado del servidor.
{$CRM_DOMAIN} {
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow"
	}
	handle /healthz {
		respond "infraestructura disponible" 200
	}
	handle {
		header Retry-After 3600
		respond "CRM-LAB: entorno en preparacion. La aplicacion todavia no esta disponible." 503
	}
}

www.{$CRM_DOMAIN} {
	redir https://{$CRM_DOMAIN}{uri} permanent
}
